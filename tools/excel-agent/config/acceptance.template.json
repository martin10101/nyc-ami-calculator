{
  "cacheWarmupYears": [
    2025
  ],
  "scenarios": [
    {
      "name": "Diagnostics smoke",
      "enabled": true,
      "workbookRole": "uap",
      "macro": "AMI_Optix_Diagnostics.ShowAMIOptixDiagnostics",
      "arguments": [],
      "assertions": [
        {
          "type": "sheet_exists",
          "sheet": "AMI Optix Diagnostics"
        },
        {
          "type": "cell_contains",
          "sheet": "AMI Optix Diagnostics",
          "cell": "A1",
          "text": "AMI Optix Diagnostics"
        }
      ]
    },
    {
      "name": "Run UAP optimization",
      "enabled": true,
      "workbookRole": "uap",
      "macro": "AMI_Optix_Automation.RunOptimizationUAP_Agent",
      "arguments": [],
      "assertions": [
        {
          "type": "sheet_exists",
          "sheet": "AMI Scenarios"
        }
      ]
    },
    {
      "name": "Run MIH optimization",
      "enabled": true,
      "workbookRole": "mih",
      "macro": "AMI_Optix_Automation.RunOptimizationMIH_Agent",
      "arguments": [],
      "assertions": [
        {
          "type": "sheet_exists",
          "sheet": "AMI Scenarios"
        }
      ]
    },
    {
      "name": "Verify Manual Rents (API)",
      "enabled": true,
      "workbookRole": "uap",
      "macro": "AMI_Optix_VerifyManualRents.VerifyManualRentsAPI_Agent",
      "arguments": [],
      "assertions": [
        {
          "type": "sheet_exists",
          "sheet": "AMI Optix Diagnostics"
        },
        {
          "type": "sheet_contains_text",
          "sheet": "AMI Optix Diagnostics",
          "text": "MATCH"
        }
      ]
    }
  ]
}
